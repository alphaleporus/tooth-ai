# ============================================
# Tooth-AI .gitignore - Deployment Ready
# ============================================

# === VIRTUAL ENVIRONMENTS ===
venv/
.venv/
env/

# === PYTHON CACHE ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# === DATASET (Large - 2GB+) ===
data/
*.jpg
*.jpeg
*.png
*.bmp

# === WANDB LOGS (10GB+) ===
wandb/

# === TEMPORARY & BACKUP ===
*.bak
*.tmp
*.log
*.swp

# === IDE ===
.vscode/
.idea/
*.code-workspace

# === OS FILES ===
.DS_Store
Thumbs.db
Desktop.ini

# === BUILD ARTIFACTS ===
build/
dist/
*.egg-info/

# === CHECKPOINTS (except final) ===
# We use Git LFS for model_final.pth
output/*/model_*.pth
!output/*/model_final.pth
output/*/last_checkpoint
output/*/events.out.*
output/inference/

# === ANNOTATIONS BACKUP ===
*_annotations.coco.json.bak
